# Copy to server/.env for local development. NEVER commit .env.
# On Vercel (the SERVER project), add the REQUIRED ones under Settings → Environment Variables.
# The client project needs no environment variables.

# ── REQUIRED (local + Vercel) ─────────────────────────────────────────────
# MongoDB Atlas connection string. Include the database name (…mongodb.net/mealvote?…).
# Atlas → Network Access must allow Vercel (0.0.0.0/0), since Vercel has no fixed IPs.
MONGODB_URI=

# Long random string used to hash guest session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later signs every guest out (their stored token hashes stop matching).
SESSION_SECRET=

# ── LOCAL ONLY (ignored on Vercel) ────────────────────────────────────────
# Port for the local API server. The client's Vite dev server reads THIS file to proxy /api here.
# 4010 because 4000 is commonly taken (e.g. the Local WordPress app).
PORT=4010

# ── OPTIONAL: only used by `npm run seed:images` (not needed at runtime) ──
# Free access key from https://unsplash.com/developers, tried before Wikimedia.
UNSPLASH_ACCESS_KEY=

# ── SET BY VERCEL, DON'T ADD ──────────────────────────────────────────────
# NODE_ENV=production   (turns on `Secure` cookies; the site must be served over https)
